<?xml version="1.0"?>
<robot name="scara" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="L1" value="0.37"/>
  <xacro:property name="L2" value="0.25"/>
  <xacro:property name="L3" value="0.20"/>
  <xacro:property name="radius" value="0.025"/>

  <xacro:property name="M1" value="2.034"/>
  <xacro:property name="M2" value="1.374"/>
  <xacro:property name="M3" value="1.099"/>

  <xacro:property name="Ixx1" value="0.02355"/>
  <xacro:property name="Iyy1" value="0.02355"/>
  <xacro:property name="Izz1" value="0.02355"/>
  <xacro:property name="Ixx2" value="0.00720"/>
  <xacro:property name="Iyy2" value="0.00720"/>
  <xacro:property name="Izz2" value="0.00720"/>
  <xacro:property name="Ixx3" value="0.00384"/>
  <xacro:property name="Iyy3" value="0.00384"/>
  <xacro:property name="Izz3" value="0.00384"/>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 1.0 1.0"/>
  </material>
  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint1" type="continuous">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="link1">
    <inertial>
      <origin xyz="${L1/2} 0 0" rpy="0 1.5708 0"/>
      <mass value="${M1}"/>
      <inertia ixx="${Ixx1}" ixy="0" ixz="0" iyy="${Iyy1}" iyz="0" izz="${Izz1}"/>
    </inertial>
    <visual>
      <origin xyz="${L1/2} 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="${radius}" length="${L1}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="${L1/2} 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="${radius}" length="${L1}"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint2" type="continuous">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="${L1} 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="link2">
    <inertial>
      <origin xyz="${L2/2} 0 0" rpy="0 1.5708 0"/>
      <mass value="${M2}"/>
      <inertia ixx="${Ixx2}" ixy="0" ixz="0" iyy="${Iyy2}" iyz="0" izz="${Izz2}"/>
    </inertial>
    <visual>
      <origin xyz="${L2/2} 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="${radius}" length="${L2}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="${L2/2} 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="${radius}" length="${L2}"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint3" type="continuous">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="${L2} 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="link3">
    <inertial>
      <origin xyz="${L3/2} 0 0" rpy="0 1.5708 0"/>
      <mass value="${M3}"/>
      <inertia ixx="${Ixx3}" ixy="0" ixz="0" iyy="${Iyy3}" iyz="0" izz="${Izz3}"/>
    </inertial>
    <visual>
      <origin xyz="${L3/2} 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="${radius}" length="${L3}"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="${L3/2} 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="${radius}" length="${L3}"/>
      </geometry>
    </collision>
  </link>

  <link name="tool0"/>
  <joint name="tool_joint" type="fixed">
    <parent link="link3"/>
    <child link="tool0"/>
    <origin xyz="${L3} 0 0" rpy="0 0 0"/>
  </joint>

  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find scara_sim)/config/scara_controllers.yaml</parameters>
    </plugin>
  </gazebo>

    <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint1">
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">1.0702</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint2">
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">1.2934</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint3">
      <command_interface name="effort">
        <param name="min">-1000</param>
        <param name="max">1000</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">2.3488</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
</robot>